    "# ── Cell 6: Write swish.py (Python wrappers) ─────────────────────────\n",
    "# (In full project this is the swish.py file — abbreviated here for Colab)\n",
    "swish_py = '''\n",
    "import math, torch, torch.nn as nn, torch.nn.functional as F\n",
    "from torch import Tensor\n",
    "\n",
    "try:\n",
    "    import swish_cuda as _C\n",
    "    _EXT = True\n",
    "except ImportError:\n",
    "    _C = None; _EXT = False\n",
    "\n",
    "def _swish_pt(x):   return x * torch.sigmoid(x)\n",
    "def _mish_pt(x):    return x * torch.tanh(F.softplus(x))\n",
    "def _swish_d_pt(x): s=torch.sigmoid(x); sw=x*s; return s+sw*(1.-s)\n",
    "def _mish_d_pt(x):\n",
    "    sp=F.softplus(x); t=torch.tanh(sp); sig=torch.sigmoid(x)\n",
    "    return t + x*(1.-t**2)*sig\n",
    "\n",
    "class SwishFunction(torch.autograd.Function):\n",
    "    @staticmethod\n",
    "    def forward(ctx, x):\n",
    "        ctx.save_for_backward(x)\n",
    "        return _C.swish_forward(x.contiguous()) if _EXT and x.is_cuda else _swish_pt(x)\n",
    "    @staticmethod\n",
    "    def backward(ctx, go):\n",
    "        x, = ctx.saved_tensors\n",
    "        if _EXT and x.is_cuda and x.dtype==torch.float32:\n",
    "            return _C.swish_backward(x.contiguous(), go.contiguous())\n",
    "        return go * _swish_d_pt(x)\n",
    "\n",
    "class MishFunction(torch.autograd.Function):\n",
    "    @staticmethod\n",
    "    def forward(ctx, x):\n",
    "        ctx.save_for_backward(x)\n",
    "        return _C.mish_forward(x.contiguous()) if _EXT and x.is_cuda else _mish_pt(x)\n",
    "    @staticmethod\n",
    "    def backward(ctx, go):\n",
    "        x, = ctx.saved_tensors\n",
    "        if _EXT and x.is_cuda and x.dtype==torch.float32:\n",
    "            return _C.mish_backward(x.contiguous(), go.contiguous())\n",
    "        return go * _mish_d_pt(x)\n",
    "\n",
    "class FusedBiasSwishFunction(torch.autograd.Function):\n",
    "    @staticmethod\n",
    "    def forward(ctx, x, bias):\n",
    "        ctx.save_for_backward(x, bias)\n",
    "        if _EXT and x.is_cuda:\n",
    "            return _C.fused_bias_swish_forward(x.contiguous(), bias.contiguous())\n",
    "        return _swish_pt(x + bias)\n",
    "    @staticmethod\n",
    "    def backward(ctx, go):\n",
    "        x, bias = ctx.saved_tensors\n",
    "        if _EXT and x.is_cuda and x.dtype==torch.float32:\n",
    "            gx, gb = _C.fused_bias_swish_backward(x.contiguous(), bias.contiguous(), go.contiguous())\n",
    "            return gx, gb\n",
    "        z=x+bias; dact=_swish_d_pt(z)\n",
    "        return go*dact, (go*dact).reshape(-1,bias.shape[0]).sum(0)\n",
    "\n",
    "def swish(x):              return SwishFunction.apply(x)\n",
    "def mish(x):               return MishFunction.apply(x)\n",
    "def fused_bias_swish(x,b): return FusedBiasSwishFunction.apply(x, b)\n",
    "\n",
    "class Swish(nn.Module):\n",
    "    def forward(self, x): return swish(x)\n",
    "\n",
    "class Mish(nn.Module):\n",
    "    def forward(self, x): return mish(x)\n",
    "\n",
    "class FusedBiasSwish(nn.Module):\n",
    "    def __init__(self, features):\n",
    "        super().__init__()\n",
    "        self.bias = nn.Parameter(torch.zeros(features))\n",
    "        nn.init.uniform_(self.bias, -1/features**0.5, 1/features**0.5)\n",
    "    def forward(self, x): return fused_bias_swish(x, self.bias)\n",
    "\n",
    "# expose for test file\n",
    "_swish_pytorch   = _swish_pt\n",
    "_mish_pytorch    = _mish_pt\n",
    "_swish_grad_pt   = _swish_d_pt\n",
    "'''\n",
    "with open('swish.py','w') as f: f.write(swish_py)\n",
    "print('Written swish.py')"
   ]
  },
