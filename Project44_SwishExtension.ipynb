    "# ── Cell 9: Training loop test ───────────────────────────────────────\n",
    "import torch, torch.nn as nn\n",
    "from swish import Swish, FusedBiasSwish\n",
    "\n",
    "print('\\n── Training Loop Tests ────────────────────────────────────────')\n",
    "\n",
    "torch.manual_seed(42)\n",
    "device, B, D = 'cuda', 32, 256\n",
    "\n",
    "# Model with our Swish\n",
    "model_s = nn.Sequential(\n",
    "    nn.Linear(D, D), Swish(), nn.Linear(D, D), Swish(), nn.Linear(D, 10)\n",
    ").to(device)\n",
    "\n",
    "# Reference model with nn.SiLU (same initial weights)\n",
    "torch.manual_seed(42)\n",
    "model_r = nn.Sequential(\n",
    "    nn.Linear(D, D), nn.SiLU(), nn.Linear(D, D), nn.SiLU(), nn.Linear(D, 10)\n",
    ").to(device)\n",
    "model_r.load_state_dict(model_s.state_dict())\n",
    "\n",
    "opt_s = torch.optim.Adam(model_s.parameters(), lr=1e-3)\n",
    "opt_r = torch.optim.Adam(model_r.parameters(), lr=1e-3)\n",
    "loss_fn = nn.CrossEntropyLoss()\n",
    "\n",
    "losses_s, losses_r = [], []\n",
    "torch.manual_seed(0)\n",
    "for _ in range(10):\n",
    "    x = torch.randn(B, D, device=device)\n",
    "    y = torch.randint(0, 10, (B,), device=device)\n",
    "    for m, o, ls in [(model_s,opt_s,losses_s),(model_r,opt_r,losses_r)]:\n",
    "        o.zero_grad(); l=loss_fn(m(x),y); l.backward(); o.step(); ls.append(l.item())\n",
    "\n",
    "diff = abs(losses_s[-1] - losses_r[-1])\n",
