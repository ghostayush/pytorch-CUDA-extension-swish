    "# ── Cell 7: Correctness tests ─────────────────────────────────────────\n",
    "import torch, torch.nn.functional as F\n",
    "from swish import swish, mish, fused_bias_swish, Swish, Mish, FusedBiasSwish\n",
    "from swish import SwishFunction, MishFunction, FusedBiasSwishFunction\n",
    "from swish import _swish_pytorch, _mish_pytorch\n",
    "\n",
    "def chk(name, a, b, atol=1e-4):\n",
    "    err = (a.float()-b.float()).abs().max().item()\n",
    "    ok  = err < atol\n",
    "    print(f\"  [{'PASS' if ok else 'FAIL'}] {name}  err={err:.2e}\")\n",
    "    return ok\n",
    "\n",
    "print('\\n── Correctness Tests ─────────────────────────────────────────')\n",
    "x32  = torch.randn(100_000, device='cuda')\n",
    "x16  = x32.half()\n",
    "\n",
    "chk('Swish float32',  swish(x32),  _swish_pytorch(x32))\n",
    "chk('Swish float16',  swish(x16).float(), _swish_pytorch(x16).float(), atol=5e-3)\n",
    "chk('Mish float32',   mish(x32),   _mish_pytorch(x32))\n",
    "\n",
    "B, C = 64, 512\n",
    "xb = torch.randn(B, C, device='cuda')\n",
    "bi = torch.randn(C, device='cuda')\n",
    "chk('FusedBiasSwish', fused_bias_swish(xb,bi), torch.sigmoid(xb+bi)*(xb+bi))\n",
    "\n",
    "# Shape tests\n",
    "for shape in [(100,),(16,64),(4,8,32),(2,4,8,16)]:\n",
    "    x_ = torch.randn(*shape, device='cuda')\n",
    "    chk(f'Swish shape={list(shape)}', swish(x_), _swish_pytorch(x_))\n",
    "\n",
    "print('\\n── Boundary Values ────────────────────────────────────────────')\n",
    "xb2 = torch.tensor([-100.,-10.,-1.,0.,1.,10.,100.], device='cuda')\n",
    "chk('Swish boundary', swish(xb2), _swish_pytorch(xb2))\n",
    "chk('Mish boundary',  mish(xb2),  _mish_pytorch(xb2))"
   ]
